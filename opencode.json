{
    "$schema": "https://opencode.ai/config.json",
    "mcp": {
        "laravel-boost": {
            "type": "local",
            "enabled": true,
            "command": [
                "php",
                "artisan",
                "boost:mcp"
            ]
        },
        "playwright": {
            "type": "local",
            "command": "docker",
            "args": [
                "run",
                "-i",
                "--rm",
                "--init",
                "--ipc=host",
                "mcp/playwright"
            ],
            "enabled": true
        }
    }
}